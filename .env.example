# Copy to .env and fill in only what you need. Everything here is optional:
# with no .env at all, the app runs on a local SQLite file with the sample data.

# Database. Leave unset to use the local SQLite file (data/app.db).
# Set to a Postgres URL to use Postgres instead, e.g. on the hosted deployment:
# DATABASE_URL=postgres://user:password@host:5432/advising_outreach

# The date the app treats as "today". The brief fixes it at 2026-10-05.
# NEXT_PUBLIC_ so the browser and the server agree on it.
NEXT_PUBLIC_REFERENCE_DATE=2026-10-05

# Prototype-only tools on the import page: load the bundled sample CSVs, reset the database.
# On unless set to false; a real deployment would turn them off.
# ENABLE_PROTOTYPE_TOOLS=false
